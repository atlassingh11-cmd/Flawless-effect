{
  "ci": {
    "collect": {
      "staticDistDir": "./dist-audit",
      "url": [
        "http://localhost/index.html",
        "http://localhost/guides/index.html",
        "http://localhost/guides/product-compliance-guide-china-imports/index.html",
        "http://localhost/guides/supplier-verification-checklist/index.html",
        "http://localhost/guides/quality-inspection-guide/index.html",
        "http://localhost/guides/canton-fair-buyers-guide/index.html",
        "http://localhost/contact-us/index.html",
        "http://localhost/sourcing-services/index.html",
        "http://localhost/privacy-policy/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile"
    }
  }
}
